# =============================================================================
# Zazi iZandi Next.js — Environment Variables
# Copy to .env.local and fill in values
# =============================================================================

# --- Required for development ---

# Mapbox (school map on /schools)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Django backend API (used by /schools-2026 server component)
DJANGO_API_URL=https://your-django-app.onrender.com

# Shared secret for server-to-server auth with the Django backend.
# Must match INTERNAL_API_SECRET in the Django .env. Generate with:
#   openssl rand -hex 32
INTERNAL_API_SECRET=generate_with_openssl_rand_hex_32

# --- Optional / Backend-only (used by Django, not Next.js) ---

# Twilio WhatsApp (not currently used in frontend)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX
# TWILIO_SECRET_KEY_SID=
# TWILIO_APIKEY_SECRET=

# TeampAct attendance API
# TEAMPACT_API_TOKEN=
# TEAMPACT_API_URL=https://teampact.co/api/analytics/v1/sessions/attendance

# OpenAI (backend use)
# OPENAI_API_KEY=

# Render PostgreSQL
# DATABASE_INTERNAL_URL=postgresql://user:pass@host/db

# Google OAuth (configured but inactive)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SurveyCTO
# SURVEYCTO_USERNAME=
# SURVEYCTO_PASSWORD=
# SURVEYCTO_DOMAIN=
