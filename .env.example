# =============================================================================
# Zazi iZandi Next.js — Environment Variables
# Copy to .env.local and fill in values
# =============================================================================

# --- Required for development ---

# Mapbox (school map on /schools)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Django backend API (used by /schools-2026 server component)
DJANGO_API_URL=https://your-django-app.onrender.com

# Shared secret for server-to-server auth with the Django backend.
# Must match INTERNAL_API_SECRET in the Django .env. Generate with:
#   openssl rand -hex 32
INTERNAL_API_SECRET=generate_with_openssl_rand_hex_32

# --- EA AI Assistant (/my-kids/today) ---

# OpenAI key used by /api/ea/brief and /api/ea/chat. Direct provider
# (we do not use the Vercel AI Gateway). Get from platform.openai.com.
OPENAI_API_KEY=sk-...

# Global kill switch. Set to "false" to disable all EA AI endpoints
# (503 response); useful for incidents or cost overruns.
EA_AI_ENABLED=true

# Model ID passed to `openai(...)` in lib/agents/ea-assistant.ts.
# Defaults to gpt-5.4-mini; override here to A/B test other models.
EA_AI_MODEL=gpt-5.4-mini

# Per-EA per-day caps. Enforced atomically by Django (select_for_update +
# F()-increment in one transaction). Partial brief rows count against
# the cap to prevent races.
EA_AI_DAILY_BRIEF_CAP=3
EA_AI_DAILY_CHAT_CAP=20

# How many user/assistant pairs of chat history to include on each turn
# (rolling window, enforced in /api/ea/chat). The system prompt is always
# rebuilt fresh with the latest snapshot, so older turns add only
# conversational context, not ground truth.
EA_AI_CHAT_HISTORY_PAIRS=6

# --- Optional / Backend-only (used by Django, not Next.js) ---

# Twilio WhatsApp (not currently used in frontend)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX
# TWILIO_SECRET_KEY_SID=
# TWILIO_APIKEY_SECRET=

# TeampAct attendance API
# TEAMPACT_API_TOKEN=
# TEAMPACT_API_URL=https://teampact.co/api/analytics/v1/sessions/attendance

# OpenAI (backend use)
# OPENAI_API_KEY=

# Render PostgreSQL
# DATABASE_INTERNAL_URL=postgresql://user:pass@host/db

# Google OAuth (configured but inactive)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SurveyCTO
# SURVEYCTO_USERNAME=
# SURVEYCTO_PASSWORD=
# SURVEYCTO_DOMAIN=
